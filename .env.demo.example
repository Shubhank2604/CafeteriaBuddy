# Safe, credential-free local demonstration settings.
# Copy this file to .env or run `npm run demo`.

AUTH_SECRET=demo-only-change-before-deployment
APP_URL=http://localhost:3000
DATABASE_PATH=./data/menu-match.db

APP_ENV=demo
DATABASE_URL=sqlite:///data/apple_hill_cafe_bot.db
DATA_DIR=data
OCR_PROVIDER=local
LLM_PROVIDER=stub
EMBEDDING_PROVIDER=local
PYTHON_EXECUTABLE=python
PYTHON_PIPELINE_TIMEOUT_MS=120000

ADMIN_EMAIL=cafe.admin@example.com
ADMIN_PASSWORD=demo-password-change-me
ADMIN_NAME=Cafe Admin

DIGEST_SCHEDULER=0
