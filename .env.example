# Web application
AUTH_SECRET=generate-a-long-random-string
APP_URL=http://localhost:3000
DATABASE_PATH=./data/menu-match.db

# Python extraction and catalogue
APP_ENV=local
DATABASE_URL=sqlite:///data/apple_hill_cafe_bot.db
DATA_DIR=data
OCR_PROVIDER=document_intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
AZURE_DOCUMENT_INTELLIGENCE_MODEL_ID=prebuilt-layout
AZURE_DOCUMENT_INTELLIGENCE_TIMEOUT_SECONDS=60
PYTHON_EXECUTABLE=python
PYTHON_PIPELINE_TIMEOUT_MS=120000

# Direct Gemini integration
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_PROVIDER=local

# Seeded cafe admin
ADMIN_EMAIL=cafe.admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Cafe Admin

# Optional morning digest email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# CRON_SECRET=
